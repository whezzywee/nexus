NEXUS_APP_DOMAIN=meet.example.com
NEXUS_TURN_DOMAIN=relay.example.com
NEXUS_TURN_EXTERNAL_IP=203.0.113.10

# Replace tags with reviewed immutable digests for a trusted release.
NEXUS_CADDY_IMAGE=caddy:2-alpine
NEXUS_COTURN_IMAGE=coturn/coturn:4-alpine
NEXUS_NODE_IMAGE=node:22-bookworm-slim
NEXUS_NGINX_IMAGE=nginx:alpine
NEXUS_RUST_IMAGE=rust:1.89.0-bookworm
NEXUS_DEBIAN_IMAGE=debian:bookworm-slim

NEXUS_TURN_TLS_FULLCHAIN_FILE=/etc/letsencrypt/live/relay.example.com/fullchain.pem
NEXUS_TURN_TLS_PRIVATE_KEY_FILE=/etc/letsencrypt/live/relay.example.com/privkey.pem
