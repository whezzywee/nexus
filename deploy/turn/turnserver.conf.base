listening-port=3478
tls-listening-port=5349
min-port=49160
max-port=49999

fingerprint
use-auth-secret
stale-nonce=600
max-allocate-lifetime=3600
user-quota=12
total-quota=12000
max-bps=2000000

cert=/run/secrets/tls_fullchain
pkey=/run/secrets/tls_private_key
no-tlsv1
no-tlsv1_1

no-cli
no-multicast-peers
no-loopback-peers
deny-peer-ip=10.0.0.0-10.255.255.255
deny-peer-ip=100.64.0.0-100.127.255.255
deny-peer-ip=127.0.0.0-127.255.255.255
deny-peer-ip=169.254.0.0-169.254.255.255
deny-peer-ip=172.16.0.0-172.31.255.255
deny-peer-ip=192.168.0.0-192.168.255.255
deny-peer-ip=::1
deny-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
deny-peer-ip=fe80::-febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff

prometheus
prometheus-address=127.0.0.1
prometheus-port=9641
log-file=stdout
simple-log
