# Client development. Values marked "development only" must never be deployed
# as durable public credentials because VITE_ values are embedded in the app.
VITE_NEXUS_FREENET_WS_URL=ws://127.0.0.1:7520/v1/contract/command
VITE_NEXUS_FREENET_WS_URL_A=ws://127.0.0.1:7520/v1/contract/command
VITE_NEXUS_FREENET_WS_URL_B=ws://127.0.0.1:7521/v1/contract/command
VITE_NEXUS_CONTRACT_INSTANCE_ID=replace-with-contract-instance-id
VITE_NEXUS_CONTRACT_CODE_HASH=replace-with-contract-code-hash
VITE_NEXUS_BRIDGE_URL=http://127.0.0.1:7530
VITE_NEXUS_BRIDGE_TOKEN=development-only-scoped-token
VITE_NEXUS_CHANNEL_ID=general
VITE_NEXUS_DISPLAY_NAME=Local developer
VITE_NEXUS_AUTH_TOKEN=development-only-scoped-token
VITE_NEXUS_TURN_CREDENTIAL_URL=
VITE_NEXUS_TURN_AUTHORIZATION=
VITE_NEXUS_RELIABILITY_ENDPOINT=

# Native desktop runtime. Prefer the managed local-node path for normal use.
NEXUS_FREENET_WS_URL=ws://127.0.0.1:7520/v1/contract/command
NEXUS_CONTRACT_INSTANCE_ID=replace-with-contract-instance-id
NEXUS_CONTRACT_CODE_HASH=replace-with-contract-code-hash
NEXUS_BRIDGE_URL=http://127.0.0.1:7530
NEXUS_BRIDGE_TOKEN=development-only-scoped-token
NEXUS_PEER=b
NEXUS_DISPLAY_NAME=Desktop developer
NEXUS_CHANNEL_ID=general
NEXUS_FREENET_AUTH_TOKEN=development-only-scoped-token
NEXUS_FREENET_BIN=C:\path\to\freenet.exe

# Gateway service. Generate unique production secrets outside the repository.
NEXUS_GATEWAY_BIND=127.0.0.1:8080
NEXUS_GATEWAY_ID=nexus-gateway-local
NEXUS_GATEWAY_HMAC_SECRET=replace-with-at-least-32-random-bytes
NEXUS_GATEWAY_CONTRACT_KEYS=replace-with-allowed-contract-key
NEXUS_GATEWAY_ORIGINS=http://127.0.0.1:5173
NEXUS_GATEWAY_UPSTREAM_URL=ws://127.0.0.1:7520/v1/contract/command
NEXUS_GATEWAY_UPSTREAM_TOKEN=replace-with-a-scoped-upstream-token
NEXUS_GATEWAY_IDEMPOTENCY_PATH=.runtime/gateway-idempotency.json
